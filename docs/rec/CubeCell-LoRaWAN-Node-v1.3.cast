[56.583, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m\u001b[96msize_t\u001b[39;49;00m\u001b[90m   \u001b[39;49;00mserialPos\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
