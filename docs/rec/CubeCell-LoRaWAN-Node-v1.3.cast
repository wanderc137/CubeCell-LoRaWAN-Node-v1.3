[56.803, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[96muint8_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mheartbeatPayload[]\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00m\u001b[94m0xBB\u001b[39;49;00m\u001b[90m \u001b[39;49;00m};\u001b[90m \u001b[39;49;00m\u001b[90m/* marcador de heartbeat */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
