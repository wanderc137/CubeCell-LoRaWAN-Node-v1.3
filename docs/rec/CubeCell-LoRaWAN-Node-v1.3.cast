[56.088, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine MAX_PAYLOAD     51\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[56.143, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine SERIAL_BUF      256\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[56.198, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine STALE_MS        500\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[56.253, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m\u001b[96m#\u001b[39;49;00m\u001b[96mdefine HEARTBEAT_MS    30000UL   \u001b[39;49;00m\u001b[90m/* heartbeat cada 30 segundos */\u001b[39;49;00m\u001b[96m\u001b[39;49;00m\n"]
[56.308, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
